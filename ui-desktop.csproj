<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">14.2</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <AssemblyName>CoreminiApp</AssemblyName>
    <RootNamespace>CoreminiApp</RootNamespace>
    <ApplicationId>com.coremini.app</ApplicationId>
    <!-- إعدادات إضافية لتجاوز قيود التوقيع للآيفون -->
    <EnableCodeSigning>false</EnableCodeSigning>
    <_RequireCodeSigning>false</_RequireCodeSigning>
  </PropertyGroup>

</Project>
